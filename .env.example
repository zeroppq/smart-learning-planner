# ===== 华为云 ModelArts Studio 模型服务 =====
# 接口地址（由项目负责人提供，形如 https://.../v1）
MODEL_API_BASE_URL=

# 访问密钥：由项目负责人本人在本地 .env 中填写，不要提交到仓库
MODEL_API_KEY=

# 默认模型名（两个智能体未单独指定时使用）
MODEL_NAME=

# 规划师使用的模型名，留空则回落到 MODEL_NAME
MODEL_NAME_PLANNER=GLM-5.3

# 督学使用的模型名，留空则回落到 MODEL_NAME
MODEL_NAME_COACH=DeepSeek-V4.1-Flash

# 数据库文件位置（可选），默认 data/learning-planner.db
DATABASE_FILE=