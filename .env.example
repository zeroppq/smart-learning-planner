# ===== 华为云 ModelArts Studio 模型服务 =====
# 接口地址（由项目负责人提供，形如 https://<ModelArts 控制台地址>/openai/v1）
# 若调用返回 404 或“模型不存在”，可先把路径 /openai/v1 改成 /v1 再试；
# 仍失败时以控制台里模型的准确调用名为准，不要自行更换模型。
# 示例（主机名为 2026-11-14 实测可用，完整路径以控制台为准）：
# MODEL_API_BASE_URL=https://api.modelarts-maas.com/openai/v1
MODEL_API_BASE_URL=

# 访问密钥：由项目负责人本人在本地 .env 中填写，不要提交到仓库
MODEL_API_KEY=

# 默认模型名（两个智能体未单独指定时使用）
MODEL_NAME=

# 规划师使用的模型名，留空则回落到 MODEL_NAME
MODEL_NAME_PLANNER=GLM-5.3

# 督学使用的模型名，留空则回落到 MODEL_NAME
MODEL_NAME_COACH=DeepSeek-V4.1-Flash

# 数据库文件位置（可选），默认 data/learning-planner.db
DATABASE_FILE=